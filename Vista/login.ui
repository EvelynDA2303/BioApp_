}

QLabel#identificationLabel,
QLabel#passwordLabel {
    color: #AAB8C9;
    font-size: 13px;
}

QLineEdit#identificationInput,
QLineEdit#passwordInput {
    background-color: #1D293B;
    color: #FFFFFF;
    border: 1px solid #26364B;
    border-radius: 14px;
    padding-left: 14px;
    font-size: 15px;
}

QLineEdit#identificationInput:focus,
QLineEdit#passwordInput:focus {
    border: 1px solid #27C6B7;
}

QPushButton#loginButton {
    background-color: #27C6B7;
    color: #10202B;
    border: none;
    border-radius: 14px;
    font-size: 17px;
    font-weight: bold;
}

QPushButton#loginButton:hover {
    background-color: #35D4C4;
}

QLabel#adminMessage {
    color: #AAB8C9;
    font-size: 14px;
    qproperty-alignment: AlignCenter;
}
</string>
