        <property name="styleSheet">
         <string notr="true">QTableWidget#tablaResultadosCSV {
    background-color: #071B2E;
    color: #FFFFFF;
    gridline-color: #167A9B;
    border: 1px solid #167A9B;
    border-radius: 6px;
    font-size: 9pt;
}

QHeaderView::section {
    background-color: #0D2940;
    color: #39D9F2;
    padding: 6px;
    border: 1px solid #167A9B;
    font-weight: bold;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: #167A9B;
    color: #FFFFFF;
}

/* Fondo de los espacios vacíos de los encabezados */
QHeaderView {
    background-color: #0D2940;
}

/* Esquina superior izquierda */
QTableCornerButton::section {
    background-color: #0D2940;
    border: 1px solid #167A9B;
}

/* Barra de desplazamiento vertical */
QScrollBar:vertical {
    background-color: #071B2E;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #167A9B;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: #39D9F2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: #071B2E;
    border: none;
}
</string>
