       <string notr="true">
QTabWidget::pane {
    background-color: rgba(5, 28, 48, 220);
    border: 1px solid #1B7896;
    border-radius: 10px;
    padding: 8px;
}

QTabBar::tab {
    background-color: #12364F;
    color: white;
    border: 1px solid #1B7896;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 150px;
    min-height: 35px;
    padding: 6px 15px;
    font-size: 13px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #087F9B;
    color: white;
    border: 1px solid #42DDF5;
}

QTabBar::tab:hover {
    background-color: #17617D;
    color: #42DDF5;
}
QWidget#tabArchivos {
    background-color: rgba(8, 35, 55, 180);
    border: none;
}
</string>
